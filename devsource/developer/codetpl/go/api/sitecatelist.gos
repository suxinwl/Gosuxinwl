package packageName

import (
	"github.com/suxinwl/GoSuxin/api/admin/baseapi"
	"github.com/suxinwl/GoSuxin/utility/gf"

	"github.com/suxinwl/GoSuxin/framework/frame/g"
)

// 数据列表
type {fileName}ListReq struct {
	g.Meta `path:"{path}/getList" tags:"getList" method:"get" summary:"列表"`
	baseapi.PageReq
	//{searchData}
}

type {fileName}ListRes struct {
	*gf.R
}

// 保存数据
type {fileName}SaveReq struct {
	g.Meta `path:"{path}/save" tags:"Save" method:"post" summary:"保存、编辑"`
	Id     int64  `p:"id" d:"0" dc:"数据id，新增时为0"`
	//{saveData}
}
type {fileName}SaveRes struct {
	*gf.R
}

// 更新状态
type {fileName}StatusReq struct {
	g.Meta `path:"{path}/upStatus" tags:"upStatus" method:"post" summary:"更新状态"`
	Id     int64 `p:"id"  v:"required#id不能为空" dc:"更新id"`
	Status uint  `p:"status" v:"required#status不能为空" dc:"状态"`
}
type {fileName}StatusRes struct {
	*gf.R
}

// 删除
type {fileName}DelReq struct {
	g.Meta `path:"{path}/del" tags:"Del" method:"delete" summary:"删除"`
	Ids    g.Array `p:"ids"`
}
type {fileName}DelRes struct {
	*gf.R
}

// 获取内容
type {fileName}ContentReq struct {
	g.Meta `path:"{path}/getContent" tags:"getContent" method:"get" summary:"获取内容详情"`
	Id     int64 `p:"id" d:"0" v:"required#id不能为空" dc:"查找数据id"`
}
type {fileName}ContentRes struct {
	*gf.R
}

// 导出Excel数据
type {fileName}ExportExcelReq struct {
	g.Meta `path:"{path}/exportExcel" tags:"exportExcel" method:"post" summary:"导出Excel数据"`
	Columns    any    `p:"columns" dc:"导出字段"`
	//{searchData}
}
type {fileName}ExportExcelRes struct {
	*gf.R
}
