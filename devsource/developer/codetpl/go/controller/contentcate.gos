	res = &{module}.CateStatusRes{R: service.{serviceName}().CateStatus(ctx, req)}
	return
}
func (c *Controller{firstModule}) CateDel(ctx context.Context, req *{module}.CateDelReq) (res *{module}.CateDelRes, err error) {
