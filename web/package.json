{
  "name": "suxinadmin",
  "description": "Suxin后台系统企业版-业务端(B端)",
  "version": "1.0.0",
  "private": true,
  "author": "Suxin技术团队",
  "license": "MIT",
  "scripts": {
    "serve": "vite --config ./config/vite.config.dev.ts",
    "build": "npm run type:check && vite build --config ./config/vite.config.prod.ts",
    "report": "cross-env REPORT=true npm run build",
    "preview": "npm run build && vite preview --config ./config/vite.config.prod.ts --host 127.0.0.1",
    "type:check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "test:layout": "node --test tests/layout.test.cjs",
    "lint-staged": "npx lint-staged",
    "build:bundle": "vite build --config ./config/vite.config.prod.ts",
    "check": "npm run type:check && npm run test:layout && npm run test:frontend && npm run build:bundle",
    "test:frontend": "node --test tests/frontend-contracts.test.cjs"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
